{
  "name": "BraidedStream-VisLab-PKUHSC",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite app --config app/vite.config.ts --host 127.0.0.1",
    "build": "npm run build:package && npm run build --workspace @braided-stream/app",
    "preview": "npm run preview --workspace @braided-stream/app",
    "build:package": "npm run build --workspace braided-stream",
    "test": "npm run build:package && vitest run",
    "test:package": "node tests/integration/package-consumer.mjs",
    "typecheck": "npm run build:package && vue-tsc --noEmit -p tsconfig.tests.json && tsc --noEmit -p scripts/figures/tsconfig.json",
    "figures:covid": "npm run build:package && vite-node scripts/figures/generate-covid.ts",
    "figures:tcm": "npm run build:package && vite-node scripts/figures/generate-tcm.ts"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/d3": "^7.4.3",
    "@types/node": "^26.2.0",
    "jsdom": "^30.1.0",
    "typescript": "^5.5.4",
    "vite": "^5.4.0",
    "vitest": "^2.0.5",
    "@vitejs/plugin-vue": "^5.2.0",
    "vue-tsc": "^2.2.0",
    "@vue/test-utils": "^2.4.6"
  },
  "allowScripts": {
    "esbuild@0.21.5": true
  },
  "workspaces": [
    "app",
    "packages/*"
  ]
}
