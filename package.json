    "typescript": "^5.5.4",
    "vite": "^5.4.0",
    "vitest": "^2.0.5"
  },
  "allowScripts": {
    "esbuild@0.21.5": true
  },
  "dependencies": {
    "d3": "^7.9.0"
  }
