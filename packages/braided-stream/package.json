{
  "name": "braided-stream",
  "version": "0.1.0",
  "type": "module",
  "description": "Framework-independent D3 braided streamgraphs and distribution analysis",
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js"
    },
    "./style.css": "./dist/style.css"
  },
  "scripts": {
    "build": "vite build --config vite.config.ts && tsc -p tsconfig.build.json",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "d3": "^7.9.0"
  },
  "dependencies": {
    "@types/d3": "^7.4.3"
  },
  "devDependencies": {
    "vite": "^5.4.0",
    "typescript": "^5.5.4"
  }
}
